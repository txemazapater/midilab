<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="MidiLab"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest><DpiAware Value="True"/></XPManifest>
      <Icon Value="0"/>
    </General>
    <BuildModes><Item Name="Default" Default="True"/></BuildModes>
    <PublishOptions><Version Value="2"/><UseFileFilters Value="True"/></PublishOptions>
    <RunParams><FormatVersion Value="2"/></RunParams>
    <RequiredPackages><Item><PackageName Value="LCL"/></Item></RequiredPackages>
    <Units>
      <Unit><Filename Value="midilab.lpr"/><IsPartOfProject Value="True"/></Unit>
      <Unit><Filename Value="mainform.pas"/><IsPartOfProject Value="True"/><ComponentName Value="Form1"/><ResourceBaseClass Value="Form"/></Unit>
      <Unit><Filename Value="patchdumpform.pas"/><IsPartOfProject Value="True"/><ComponentName Value="MidiPatchDumpForm"/><ResourceBaseClass Value="Form"/></Unit>
      <Unit><Filename Value="discoveryform.pas"/><IsPartOfProject Value="True"/><ComponentName Value="MidiDiscoveryForm"/><ResourceBaseClass Value="Form"/></Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target><Filename Value="midilab"/></Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="..\core;..\backends;..\protocols\roland"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging><DebugInfoType Value="dsDwarf3"/></Debugging>
      <Options><Win32><GraphicApplication Value="True"/></Win32></Options>
    </Linking>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item><Name Value="EAbort"/></Item>
      <Item><Name Value="ECodetoolError"/></Item>
      <Item><Name Value="EFOpenError"/></Item>
    </Exceptions>
  </Debugging>
</CONFIG>
